# Public site origin (no trailing slash). Used for metadataBase, OG URLs, sitemap.
# Production default in code: https://web-portal-co-politica.vercel.app
NEXT_PUBLIC_SITE_URL=https://web-portal-co-politica.vercel.app

# Firebase (project: web-portal-cpc). Optional in CI — UI falls back to local seed.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=web-portal-cpc.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=web-portal-cpc
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=web-portal-cpc.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=583147655555
NEXT_PUBLIC_FIREBASE_APP_ID=
